-- Customers
CREATE TABLE customers (
  customer_id   INT PRIMARY KEY,
  first_name    TEXT NOT NULL,
  last_name     TEXT NOT NULL,
  email         TEXT UNIQUE,
  phone         TEXT,
  city          TEXT,
  dob           DATE
);

-- Branch
CREATE TABLE branch (
  branch_id     INT PRIMARY KEY,
  branch_name   TEXT NOT NULL,
  city          TEXT
);

-- Accounts
CREATE TABLE accounts (
  account_id       INT PRIMARY KEY,
  account_type     TEXT NOT NULL,           -- e.g., 'saving', 'current'
  account_balance  TEXT NOT NULL,           -- Q1 converts this to numeric
  dop              DATE,                    -- date of opening
  customer_id      INT NOT NULL REFERENCES customers(customer_id)
  -- If your schema has it, add: branch_id INT REFERENCES branch(branch_id)
);

-- Loan
CREATE TABLE loan (
  loan_id       INT PRIMARY KEY,
  loan_type     TEXT,
  customer_id   INT NOT NULL REFERENCES customers(customer_id),
  account_id    INT NOT NULL REFERENCES accounts(account_id),
  branch_id     INT NOT NULL REFERENCES branch(branch_id)
  -- If present: , loan_amount NUMERIC(12,2)
);

